# 统一换行符策略。
# 目标机是 Linux：shell 脚本 / systemd unit 若带 CRLF 会直接报
# "bad interpreter: /bin/bash^M"，必须在索引层强制 LF。

* text=auto

# 必须在 Linux 上以 LF 存在
*.sh      text eol=lf
*.py      text eol=lf
*.ini     text eol=lf
*.tmpl    text eol=lf

# Windows 侧脚本保持 CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 生成物必须钉死 LF —— 它们会被**逐字节**比对
# （`dump_openapi.py --check` 比 web/openapi.json，`check.sh` 重新生成 schema.d.ts 再比）。
# 只写 `* text=auto` 是不够的：在 core.autocrlf=true 的 Windows 上，一次新 checkout
# 就会把它们变成 CRLF，于是"生成物是否已最新"永远为假、仓库卫生检查也会红 ——
# 而这两者报出来的都是"有人改了代码没重新生成"，指不到真正的原因（行尾符）。
web/openapi.json         text eol=lf
web/src/api/schema.d.ts  text eol=lf

# 二进制
*.db      binary
*.png     binary
*.jpg     binary
*.gz      binary
*.whl     binary
