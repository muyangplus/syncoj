[Unit]
Description=SyncOJ Agent（选手端代码回收，无界面静默运行）
Documentation=https://example.invalid/syncoj
# 网络就绪后再启动，否则第一轮必然失败（虽然会自动退避重试）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -E -s /opt/syncoj/agent/main.py --config /etc/syncoj/agent.ini

# ---- 静默 ----
# 不往终端/日志设备写任何东西。Agent 自己的日志走 state_dir 下的轮转文件。
# 保留 stderr 进 journal，便于 systemctl status 排查启动期错误。
StandardOutput=null
StandardError=journal

# ---- 自愈 ----
Restart=always
RestartSec=5
# 反复崩溃时不要无限重启：5 分钟内起不来就停下来等人看
StartLimitIntervalSec=300
StartLimitBurst=5

# ---- 权限隔离 ----
# 专用非特权账号。注意：这是最后一道防线，不是唯一防线 ——
# 服务端也有独立的路径校验，两边互为纵深。
User=syncoj
Group=syncoj
# 禁止通过 setuid/setgid 提权
NoNewPrivileges=yes
# 私有 /tmp，防止与其他进程通过临时文件互相干扰
PrivateTmp=yes
# 私有 /dev（仅保留 null/zero/random 等必要设备）
PrivateDevices=yes
# 整个文件系统只读挂载，只放开下面显式列出的路径
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
# 只允许 IPv4/IPv6 套接字，禁止其他 socket 家族
RestrictAddressFamilies=AF_INET AF_INET6
# 禁止挂载、禁止修改内核日志
LockPersonality=yes

# 可写路径：状态目录 + 下发落地目录
ReadWritePaths=/var/lib/syncoj /home/student/exam
# 只读路径：选手代码目录（Agent 只读不写，绝不该改选手的代码）
ReadOnlyPaths=/home/student/code

# ---- 资源限制 ----
MemoryMax=200M
MemoryHigh=160M
CPUQuota=25%
IOSchedulingClass=idle
IOSchedulingPriority=7
# 文件描述符上限：连接 + 打开的源文件，留够余量
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
