{
  "name": "syncoj-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SyncOJ 管理界面",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:routes && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:routes": "node scripts/check-routes.mjs",
    "gen:types": "openapi-typescript ./openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.8.8",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
